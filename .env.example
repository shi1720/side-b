# Copy to .env.local for native Next.js development. Never commit real secrets.
APP_ORIGIN=http://127.0.0.1:3000
GOOGLE_CLOUD_PROJECT=demo-side-b
FIRESTORE_DATABASE_ID=side-b
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# Server-only Qloo access. Guest stock browsing works without this key;
# live cultural search and planning require a valid key for the chosen server.
QLOO_API_KEY=
QLOO_API_BASE=https://hackathon.api.qloo.com

# Optional for local Google sign-in. Use a real Firebase project's public web
# configuration and matching GOOGLE_CLOUD_PROJECT; authorize the local domain.
# The Firestore emulator alone does not emulate Google authentication.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# Production: omit FIRESTORE_EMULATOR_HOST, set your canonical HTTPS APP_ORIGIN,
# use your own project/database and runtime service account, and supply
# QLOO_API_KEY through Secret Manager. See docs/DEPLOYMENT.md.
